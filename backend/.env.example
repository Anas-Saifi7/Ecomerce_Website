# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/hallabol

# JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRE=7d

# Frontend (CORS + password reset links)
FRONTEND_URL=http://localhost:5173

# One-time seed admin; seed also requires SEED_CONFIRM_DATABASE to match MONGO_URI database name
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_CONFIRM_DATABASE=

# Razorpay (leave blank to disable online payments — endpoints return 503)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP (required to deliver password reset links; no links are logged without SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Halla Bol <noreply@hallabol.com>"

# Durable signed image storage (required for admin image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
